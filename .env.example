# ============================================================
# Óptica Bellavista - Variables de entorno
# Copie este archivo como .env y complete los valores reales.
# .env NO se versiona y nunca debe subirse al repositorio.
# ============================================================

# En local: DB_HOST=db.
# En AWS: DB_HOST=<endpoint-privado-de-RDS> y DB_PORT=3306.
DB_HOST=db
DB_PORT=3306
DB_NAME=optica_bellavista
DB_USER=bellavista_user
DB_PASS=
DB_ROOT_PASSWORD=

APP_ENV=production
APP_TIMEZONE=America/Lima

# Tiempo de expiración de sesión por inactividad, en segundos (30 min).
SESSION_IDLE_TIMEOUT=1800

# Ruta del log estructurado para Wazuh SIEM.
SECURITY_LOG_PATH=/var/log/app/security.log

# Directorio de trabajo del rate limiting de login.
RATE_LIMIT_DIR=/tmp/optica_bellavista_ratelimit