<!--
  Reglas custom Óptica Bellavista (IDs 100200-100214, rango libre 100000-120000).
  Padres: decoder nativo json (log_format json) y decoder propio optica_bellavista.
-->
<group name="optica_bellavista,">

  <rule id="100200" level="0">
    <decoded_as>json</decoded_as>
    <field name="app">optica_bellavista</field>
    <description>Óptica Bellavista: evento JSON de la aplicación</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100201" level="0">
    <decoded_as>optica_bellavista</decoded_as>
    <description>Óptica Bellavista: evento vía decoder propio</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100202" level="3">
    <if_sid>100200,100201</if_sid>
    <field name="event">login_success</field>
    <description>Óptica Bellavista: inicio de sesión exitoso ($(user))</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100203" level="5">
    <if_sid>100200,100201</if_sid>
    <field name="event">login_failed</field>
    <description>Óptica Bellavista: login fallido ($(user) desde $(ip))</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100204" level="10">
    <if_sid>100200,100201</if_sid>
    <field name="event">login_rate_limited</field>
    <description>Óptica Bellavista: login bloqueado por rate limit ($(user) desde $(ip))</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100205" level="12" frequency="5" timeframe="900">
    <if_matched_sid>100203</if_matched_sid>
    <same_field>user</same_field>
    <same_field>ip</same_field>
    <description>Óptica Bellavista: posible fuerza bruta (5 login_failed en 15 min)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100206" level="3">
    <if_sid>100200,100201</if_sid>
    <field name="event">session_expired</field>
    <description>Óptica Bellavista: sesión expirada por inactividad ($(user))</description>
  </rule>

  <rule id="100207" level="3">
    <if_sid>100200,100201</if_sid>
    <field name="event">logout</field>
    <description>Óptica Bellavista: cierre de sesión ($(user))</description>
  </rule>

  <rule id="100208" level="5">
    <if_sid>100200,100201</if_sid>
    <field name="event">contract_created</field>
    <description>Óptica Bellavista: contrato creado</description>
  </rule>

  <rule id="100209" level="7">
    <if_sid>100200,100201</if_sid>
    <field name="event">contract_cancelled</field>
    <description>Óptica Bellavista: contrato anulado (stock restituido)</description>
  </rule>

  <rule id="100210" level="5">
    <if_sid>100200,100201</if_sid>
    <field name="event">payment_received</field>
    <description>Óptica Bellavista: abono de caja registrado</description>
  </rule>

  <rule id="100211" level="5">
    <if_sid>100200,100201</if_sid>
    <field name="event">expense_created</field>
    <description>Óptica Bellavista: egreso de caja registrado</description>
  </rule>

  <rule id="100212" level="7">
    <if_sid>100200,100201</if_sid>
    <field name="event">user_created</field>
    <description>Óptica Bellavista: usuario creado</description>
    <group>adduser,account_changed,</group>
  </rule>

  <rule id="100213" level="5">
    <if_sid>100200,100201</if_sid>
    <field name="event">user_updated</field>
    <description>Óptica Bellavista: usuario actualizado</description>
    <group>account_changed,</group>
  </rule>

  <rule id="100214" level="8">
    <if_sid>100200,100201</if_sid>
    <field name="event">user_status_changed</field>
    <description>Óptica Bellavista: estado de usuario cambiado</description>
    <group>account_changed,</group>
  </rule>

  <rule id="100215" level="10">
    <if_sid>100200,100201</if_sid>
    <field name="event">password_reset</field>
    <description>Óptica Bellavista: restablecimiento de contraseña</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>account_changed,</group>
  </rule>

</group>
